				}
			},
			{
				"scope": "geode.flalert.blue",
				"settings": {
					"foreground": "#4a52e1"
				}
			},
			{
				"scope": "geode.flalert.green",
				"settings": {
					"foreground": "#40e348"
				}
			},
			{
				"scope": "geode.flalert.aqua",
				"settings": {
					"foreground": "#60abef"
				}
			},
			{
				"scope": "geode.flalert.cyan",
				"settings": {
					"foreground": "#32c8ff"
				}
			},
			{
				"scope": "geode.flalert.yellow",
				"settings": {
					"foreground": "#ffff00"
				}
			},
			{
				"scope": "geode.flalert.orange",
				"settings": {
					"foreground": "#ffa54b"
				}
			},
			{
				"scope": "geode.flalert.red",
				"settings": {
					"foreground": "#ff5a5a"
				}
			},
			{
				"scope": "geode.flalert.pink",
				"settings": {
					"foreground": "#ff00ff"
				}
			},
			{
				"scope": "geode.flalert.purple",
				"settings": {
					"foreground": "#9632ff"
				}
			},
			{
				"scope": "renpy.meta.color.#cfc",
				"settings": {
					"foreground": "#cfc"
				}
			},
			{
				"scope": "renpy.meta.color.#fff",
				"settings": {
					"foreground": "#fff"
				}
			}
		]
	}
}
